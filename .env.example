# Configuração SMTP — Praia Digital
# Preencha com credenciais reais antes de executar o envio.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-aqui
SMTP_FROM=seu-email@gmail.com

# App / FastAPI
DATABASE_URL=postgres://user:pass@localhost:5432/academy
SECRET_KEY=sua-chave-secreta-aqui
BASE_URL=https://academy.praia.digital
APP_ENV=production

# SMTP — envio de e-mails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-aqui
EMAIL_FROM=no-reply@praia.digital

# Mercado Pago
MERCADOPAGO_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_API_URL=https://api.mercadopago.com/v1

# Payments / gateways
PAYMENT_GATEWAY=sandbox
PAYMENT_SECRET=
PAYMENT_WEBHOOK_PATH=/academy/payments/webhook

# Hotmart
HOTMART_API=https://api.hotmart.com
HOTMART_TOKEN=
HOTMART_SECRET=

# CORS
ALLOWED_ORIGINS=https://praia.digital,https://academy.praia.digital

# WhatsApp Cloud API
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO_NUMBER=
